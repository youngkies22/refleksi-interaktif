# Semua baris di bawah ini OPSIONAL — aplikasi jalan tanpa file .env sama sekali.
# Salin ke .env hanya kalau ingin mengubah nilai bawaan.

# Port yang dibuka di host (dalam container selalu 8080)
PORT=4001

APP_NAMA=Refleksi

# Setel true HANYA kalau aplikasi diakses lewat https:// (TLS diterminasi di
# reverse proxy seperti nginx/aaPanel). Kalau diakses lewat http://, biarkan
# false — mengisinya true akan membuat browser memaksa CSS/JS diambil lewat
# https sehingga halaman gagal dimuat, dan HSTS mengunci domain ke https.
PAKAI_HTTPS=false

# Akun admin awal — HANYA dipakai saat database masih kosong (boot pertama).
# Kalau databasenya sudah berisi akun, kedua nilai ini diabaikan; ganti lewat
# menu "Profil Saya" di aplikasi.
# Kosongkan ADMIN_PASSWORD kalau ingin password acak dibuat otomatis dan
# dicetak ke `docker compose logs -f app`.
ADMIN_USERNAME=smkbudut
ADMIN_PASSWORD=smkbudut

# Kosongkan supaya dibuat otomatis dan disimpan permanen di volume data
# (tidak berubah walau container di-rebuild).
SESSION_SECRET=

# Backup panas SQLite ke /data/backup. 0 = matikan.
BACKUP_TIAP_MENIT=30

LOG_LEVEL=info

# Object storage S3-compatible (mis. NevaObjects/Nevacloud) untuk gambar
# unggahan (slide pin-jawaban, logo branding, lampiran kartu papan). Kosongkan
# KEEMPATNYA untuk memakai bawaan: simpan di disk lokal (folder data/unggahan
# di dalam volume) seperti sebelum variabel ini ada — tidak wajib diisi.
#
# Bucket-nya HARUS diset publik-baca (public-read) di panel penyedia, karena
# gambar disajikan langsung dari URL objek tanpa lewat server ini.
#
# Nilai-nilai ini HANYA dipakai sekali untuk seed awal saat boot pertama —
# sesudahnya, ubah lewat panel admin (Kelola Guru → Object Storage), bukan
# di sini, supaya tidak "kembali" ke nilai lama tiap container di-rebuild.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# WAJIB diisi kalau memakai Cloudflare R2 (endpoint S3 R2 privat, tidak bisa
# jadi URL gambar langsung) — isi domain publik bucket-nya (custom domain
# atau subdomain *.r2.dev). Kosongkan untuk penyedia lain (endpoint-nya
# sendiri sudah publik, mis. NevaObjects).
S3_URL_PUBLIK=
